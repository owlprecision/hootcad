{
  "name": "hootcad",
  "displayName": "HootCAD",
  "description": "VS Code and Cursor extension to view JSCAD files",
  "version": "0.2.1",
  "publisher": "owlprecision",
  "repository": {
    "type": "git",
    "url": "https://github.com/owlprecision/hootcad"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "icon": "logo.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "jscad",
    "3d",
    "cad",
    "modeling",
    "preview",
    "cursor",
    "vscode"
  ],
  "activationEvents": [
    "onCommand:hootcad.openPreview",
    "onCommand:hootcad.export",
    "onCommand:hootcad.enableMcp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hootcad.openPreview",
        "title": "HootCAD: Open Preview"
      },
      {
        "command": "hootcad.export",
        "title": "HootCAD: Export"
      },
      {
        "command": "hootcad.enableMcp",
        "title": "HootCAD: Enable MCP Server"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "hootcad.mcp-servers",
        "label": "HootCAD MCP Servers"
      }
    ],
    "languages": [
      {
        "id": "javascript",
        "extensions": [
          ".jscad"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out && mkdir -p out/webview && cp src/webview/cameraController.js src/webview/inputController.js out/webview/",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package:vsix": "vsce package --skip-license",
    "bench:cadgen": "node scripts/cadgenbench/run-bench.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "@types/vscode": "1.101.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "acorn": "^8.17.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "dependencies": {
    "@jscad/amf-serializer": "^2.1.23",
    "@jscad/dxf-serializer": "^2.1.23",
    "@jscad/json-serializer": "^2.0.33",
    "@jscad/modeling": "^2.13.0",
    "@jscad/obj-serializer": "^2.1.23",
    "@jscad/stl-serializer": "^2.1.23",
    "@jscad/svg-serializer": "^2.3.21",
    "@jscad/x3d-serializer": "^2.4.13",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mathjs": "^15.2.0",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
